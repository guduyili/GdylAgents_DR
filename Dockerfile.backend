FROM python:3.12-slim

WORKDIR /app

# 换用阿里云镜像源（国内服务器加速）
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && apt-get install -y --no-install-recommends \
    gcc curl \
    && rm -rf /var/lib/apt/lists/*

# 安装 uv（使用国内镜像）
RUN pip install --no-cache-dir uv -i https://mirrors.aliyun.com/pypi/simple/

# 复制依赖声明文件（利用 Docker 层缓存）
COPY pyproject.toml uv.lock ./

# 用 uv 根据锁文件精确安装（--no-install-project 跳过构建本项目包，只装依赖）
ENV UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
RUN uv sync --frozen --no-dev --no-install-project
RUN uv pip install huggingface_hub    
ENV PATH="/app/.venv/bin:$PATH"

# 复制源码
COPY src/ ./src/

WORKDIR /app/src

# 创建笔记目录
RUN mkdir -p /data/notes

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://0.0.0.0:8000/healthz || exit 1

# 直接使用构建阶段生成的虚拟环境，避免运行时再次触发 uv 项目构建
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
