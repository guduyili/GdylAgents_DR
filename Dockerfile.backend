FROM python:3.12-slim

WORKDIR /app

# 换用阿里云镜像源（国内服务器加速）
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && apt-get install -y --no-install-recommends \
    gcc curl \
    && rm -rf /var/lib/apt/lists/*

# 安装 uv（使用国内镜像）
RUN pip install --no-cache-dir uv -i https://mirrors.aliyun.com/pypi/simple/

# 复制依赖声明文件（利用 Docker 层缓存）
COPY pyproject.toml uv.lock ./

# 用 uv 根据锁文件精确安装（--no-install-project 跳过构建本项目包，只装依赖）
ENV UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# 指定 note 存储绝对路径，避免相对路径因 cwd 不同写到错误位置
ENV NOTES_WORKSPACE=/app/src/note
# Docker 默认启用 SQLite run store，并写入挂载的数据目录
ENV RUN_STORE_BACKEND=sqlite
ENV RUN_STORE_DB_PATH=/app/src/data/research_runs.sqlite3
RUN uv sync --frozen --no-dev --extra redis --no-install-project

# 复制源码与 Skill 工作区（与 src/ 同级，运行时 WORKDIR 为 /app/src）
COPY src/ ./src/
COPY skills/ ./src/skills/

ENV PYTHONPATH=/app/src
WORKDIR /app/src

# 创建笔记目录和 SQLite run_store 数据目录（对应 compose 挂载路径）
RUN mkdir -p /app/src/note /app/src/data

# 研究流水线与可靠性默认值（compose / .env 可覆盖）
ENV SKILLS_WORKSPACE=/app/src/skills
ENV RESEARCH_MODE=deep
ENV ENABLE_FACT_CHECK=true
ENV ENABLE_REPORT_REVIEW=true
ENV RESEARCH_PIPELINE=plan,search,summarize,fact_check,report,review
ENV ENABLE_BROWSER_FETCH=false
ENV MAX_CONCURRENT_TASKS=4
ENV SEARCH_TIMEOUT_SECONDS=60
ENV SUMMARY_TIMEOUT_SECONDS=120
ENV SEARCH_FALLBACK_CHAIN=duckduckgo,tavily

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8000/healthz || exit 1

# 直接调用构建期虚拟环境，避免运行时 uv sync 拖慢启动
CMD ["/app/.venv/bin/uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
