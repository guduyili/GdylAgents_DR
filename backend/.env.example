# LLM provider: ollama / lmstudio / custom
LLM_PROVIDER=custom

# OpenAI-compatible custom provider settings
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=your-api-key
LLM_MODEL_ID=your-model-id
REPORT_MODEL_ID=your-report-model-id

# Local provider settings
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LOCAL_LLM=llama3.2

# Search backend: tavily / duckduckgo / perplexity / searxng / advanced
SEARCH_API=duckduckgo
TAVILY_API_KEY=your-tavily-api-key

# Research behavior
MAX_WEB_RESEARCH_LOOPS=3
FETCH_FULL_PAGE=true
ENABLE_BROWSER_FETCH=false
# 启用 browser fetch 时需安装 Playwright：pip install playwright && playwright install chromium
STRIP_THINKING_TOKENS=true
USE_TOOL_CALLING=false
MAX_CONCURRENT_TASKS=4
SEARCH_TIMEOUT_SECONDS=60
SUMMARY_TIMEOUT_SECONDS=120
SEARCH_FALLBACK_CHAIN=duckduckgo,tavily
RESEARCH_MODE=deep
ENABLE_REPORT_REVIEW=true
ENABLE_FACT_CHECK=true
SKILLS_WORKSPACE=./skills
RESEARCH_PIPELINE=plan,search,summarize,fact_check,report,review

# Notes and report persistence
ENABLE_NOTES=true
NOTES_WORKSPACE=./data/notes

# Research run timeline persistence
RUN_STORE_BACKEND=sqlite
RUN_STORE_DB_PATH=./data/research_runs.sqlite3
